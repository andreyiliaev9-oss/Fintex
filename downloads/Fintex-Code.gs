  if(/кофе|кафе|ресторан|бургер|пицц|суши/i.test(s))return 'cafe';
  if(/ozon|озон|wildberries|dns|м\.видео/i.test(s))return 'shop';
  if(/подписк|плюс|мтс|билайн|кинопоиск/i.test(s))return 'subs';
