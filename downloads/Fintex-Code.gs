function normalizeMerchantServer(raw) {
  var s=String(raw||'').replace(/(?:покупка|оплата|списание|зачисление|пополнение|карта|mir-\d+|\*\d{4}|rub|rur|руб\.?|₽)/gi,' ').replace(/\s+/g,' ').trim();
